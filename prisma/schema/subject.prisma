model Subject {
  id          String   @id @default(uuid())
  subjectCode String   @unique
  subjectName String
  description String
  teacherId   String?
  creditHours Int
  createdAt   DateTime @default(now())
  level       Level

  // Relations
  teacher     Teacher?       @relation(fields: [teacherId], references: [id])
  assessments Assessment[]
  classLinks  ClassSubject[]
}
